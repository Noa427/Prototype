# Base de données
DATABASE_URL=postgresql://user:password@localhost:5432/aevum

# Sécurité JWT
SECRET_KEY=SUPER_SECRET_KEY_CHANGE_ME

# Environnement
ENV=dev
ALLOWED_ORIGINS=http://localhost:5173

# Signature électronique Yousign
YOUSIGN_API_KEY=your_key_here
YOUSIGN_WEBHOOK_SECRET=your_secret_here

# Email (SMTP ou SendGrid)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@email.com
SMTP_PASSWORD=your_password

# SMS (Twilio)
TWILIO_ACCOUNT_SID=your_sid
TWILIO_AUTH_TOKEN=your_token
TWILIO_FROM_NUMBER=+33600000000

# IA Scoring
DEEPSEEK_API_KEY=your_deepseek_key

# Frontend
VITE_API_URL=http://localhost:8000
VITE_LICENSE_KEY=your_license_key
